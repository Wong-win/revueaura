---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../content.config';

export async function getStaticPaths() {
  return Object.entries(CATEGORIES).map(([slug, label]) => ({
    params: { slug },
    props: { slug, label },
  }));
}

interface Props {
  slug: string;
  label: string;
}

const { slug, label } = Astro.props;
const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => a.data.categorySlugs.includes(slug))
  .sort((a, b) => {
    const ap = a.data.pinned ? 1 : 0;
    const bp = b.data.pinned ? 1 : 0;
    if (ap !== bp) return bp - ap;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

const featured = articles[0];
const rest = articles.slice(1);

function fmtRelative(iso: string | Date) {
  const d = new Date(iso);
  const now = Date.now();
  const diff = now - d.getTime();
  const day = 86400000;
  if (diff < day) return `${Math.floor(diff / 3600000)}h ago`;
  if (diff < 7 * day) return `${Math.floor(diff / day)}d ago`;
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

function authorInitial(name?: string) {
  return (name ?? 'E').charAt(0).toUpperCase();
}
---

<Layout title={label} description={`${label} — editorial essays on RevueAura.`}>
  <Header />

  <main class="container">

    <!-- Category header — simple, like appleosophy -->
    <header class="cat-head">
      <span class={`tag tag-${slug}`}>{label}</span>
      <h1>{label}</h1>
      <p class="cat-blurb">Editorial essays, slow reads, and considered notes from the {label.toLowerCase()} desk.</p>
    </header>

    <!-- Featured card -->
    {featured && (
      <section class="cat-featured">
        <a href={`/${featured.data.slug}/`} class="cat-feat-img">
          <img src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} loading="eager" />
          <div class="overlay"></div>
        </a>
        <div class="cat-feat-body">
          <a href={`/${featured.data.slug}/`}><h2>{featured.data.title}</h2></a>
          <div class="byline">
            <span class="avatar">{authorInitial(featured.data.author)}</span>
            <span class="byline-name">{featured.data.author ?? 'Editorial'}</span>
            <span class="byline-dot">·</span>
            <span class="byline-time">{fmtRelative(featured.data.date)}</span>
          </div>
        </div>
      </section>
    )}

    <!-- 2-col card grid -->
    <div class="grid-2">
      {rest.map(a => (
        <article class="card">
          <a href={`/${a.data.slug}/`} class="card-img">
            <img src={a.data.image} alt={a.data.imageAlt ?? a.data.title} loading="lazy" />
          </a>
          <a href={`/category/${a.data.categorySlugs[0]}/`}>
            <span class={`tag tag-${a.data.categorySlugs[0]}`}>{a.data.categories[0]}</span>
          </a>
          <a href={`/${a.data.slug}/`}><h3>{a.data.title}</h3></a>
          <div class="byline">
            <span class="avatar avatar-sm">{authorInitial(a.data.author)}</span>
            <span class="byline-name">{a.data.author ?? 'Editorial'}</span>
            <span class="byline-dot">·</span>
            <span class="byline-time">{fmtRelative(a.data.date)}</span>
          </div>
        </article>
      ))}
    </div>

  </main>

  <Footer />
</Layout>

<style>
  .cat-head {
    padding: 32px 0 24px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 28px;
  }

  .cat-head h1 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1.16;
    letter-spacing: -0.02em;
    margin: 12px 0 8px;
  }

  .cat-blurb {
    font-size: 0.98rem;
    color: var(--text-soft);
    margin: 0;
    max-width: 600px;
  }

  /* Featured card with overlay */
  .cat-featured {
    position: relative;
    margin: 0 0 36px;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 7;
    max-height: 480px;
  }

  .cat-feat-img { display: block; width: 100%; height: 100%; }
  .cat-feat-img img { width: 100%; height: 100%; object-fit: cover; }
  .overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 30%, rgba(0,0,0,0.85) 100%);
  }

  .cat-feat-body {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 24px 28px;
    color: white;
  }

  .cat-feat-body h2 {
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.018em;
    margin: 0 0 12px;
    color: white;
  }

  .cat-feat-body .byline { color: rgba(255,255,255,0.85); }
  .cat-feat-body .byline-name { color: white; }
  .cat-feat-body .byline-dot { color: rgba(255,255,255,0.4); }

  /* 2-col grid */
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 24px;
  }

  .card { display: flex; flex-direction: column; }

  .card-img {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
  }

  .card-img img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card .tag { margin-bottom: 10px; }

  .card h3 {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.012em;
    margin: 0 0 10px;
  }

  .card h3:hover { color: var(--accent); }

  .byline {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .avatar {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff3b30, #ff9500, #34c759, #007aff);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .avatar-sm { width: 22px; height: 22px; font-size: 0.68rem; }

  .byline-name { font-weight: 600; color: var(--text); }
  .byline-dot { color: var(--rule); }

  @media (max-width: 720px) {
    .cat-featured { aspect-ratio: 16 / 9; max-height: 360px; }
    .grid-2 { grid-template-columns: 1fr; }
  }
</style>