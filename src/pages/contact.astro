---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact" description="Get in touch with the RevueAura editorial desk.">
  <Header />
  <main class="container">
    <article class="prose contact-page">
      <header class="page-head">
        <span class="tag">Contact</span>
        <h1>Write to us.</h1>
        <p class="lede">Pitch a story, share a tip, or simply say hello. We read everything.</p>
      </header>

      <div class="contact-grid">
        <div class="contact-card">
          <h2>Editorial</h2>
          <p>Pitches, op-eds, and editorial correspondence.</p>
          <a href="mailto:editorial@revueaura.com" class="email-link">editorial@revueaura.com</a>
        </div>

        <div class="contact-card">
          <h2>Tips</h2>
          <p>Confidential leads, source notes, and field reporting.</p>
          <a href="mailto:tips@revueaura.com" class="email-link">tips@revueaura.com</a>
        </div>

        <div class="contact-card">
          <h2>Letters</h2>
          <p>Reader mail, corrections, and friendly replies.</p>
          <a href="mailto:letters@revueaura.com" class="email-link">letters@revueaura.com</a>
        </div>
      </div>

      <p class="response-note">We aim to respond within five working days. Not all pitches can be published, but every thoughtful note gets a reply.</p>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .contact-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 36px 0;
  }

  .page-head { margin-bottom: 32px; }

  .page-head h1 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    line-height: 1.18;
    letter-spacing: -0.018em;
    margin: 12px 0 10px;
  }

  .lede {
    font-size: 1.02rem;
    color: var(--text-soft);
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px;
    margin-bottom: 28px;
  }

  .contact-card {
    background: var(--surface-2);
    border-radius: var(--radius);
    padding: 18px;
  }

  .contact-card h2 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 6px;
  }

  .contact-card p {
    font-size: 0.88rem;
    color: var(--text-soft);
    margin-bottom: 10px;
  }

  .email-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--accent);
  }

  .email-link:hover { text-decoration: underline; }

  .response-note {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 24px;
  }
</style>