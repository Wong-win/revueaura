---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Not Found">
  <Header />
  <main class="container">
    <div class="nf-wrap">
      <p class="nf-code">404</p>
      <h1>This page drifted out of frame.</h1>
      <p class="nf-sub">The story you're looking for isn't here. Perhaps it found another home, or perhaps it was never written.</p>
      <a href="/" class="btn">← Back to Latest</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .nf-wrap {
    text-align: center;
    padding: 80px 20px 60px;
    max-width: 480px;
    margin: 0 auto;
  }

  .nf-code {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 4rem;
    color: var(--accent);
    line-height: 1;
    margin: 0 0 8px;
    letter-spacing: -0.04em;
  }

  h1 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.4vw, 1.7rem);
    margin: 0 0 14px;
  }

  .nf-sub {
    font-size: 0.98rem;
    color: var(--text-soft);
    margin-bottom: 24px;
    line-height: 1.55;
  }
</style>