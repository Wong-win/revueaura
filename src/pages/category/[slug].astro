---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../content.config';

export async function getStaticPaths() {
  return Object.entries(CATEGORIES).map(([slug, label]) => ({
    params: { slug },
    props: { slug, label },
  }));
}

interface Props {
  slug: string;
  label: string;
}

const { slug, label } = Astro.props;
const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => a.data.categorySlugs.includes(slug))
  .sort((a, b) => {
    const ap = a.data.pinned ? 1 : 0;
    const bp = b.data.pinned ? 1 : 0;
    if (ap !== bp) return bp - ap;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

function fmtRelative(iso: string | Date) {
  const d = new Date(iso);
  const now = Date.now();
  const diff = now - d.getTime();
  const day = 86400000;
  if (diff < day) return `${Math.floor(diff / 3600000)}h ago`;
  if (diff < 7 * day) return `${Math.floor(diff / day)}d ago`;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function authorInitial(name?: string) {
  return (name ?? 'E').charAt(0).toUpperCase();
}
---

<Layout title={label} description={`${label} — editorial essays on RevueAura.`}>
  <Header />

  <main class="container">
    <header class="cat-header">
      <span class={`tag tag-${slug}`}>{label}</span>
      <h1>{label}</h1>
      <p class="cat-blurb">Editorial essays, slow reads, and considered notes — from the {label.toLowerCase()} desk.</p>
      <p class="cat-count">{articles.length} {articles.length === 1 ? 'story' : 'stories'}</p>
    </header>

    <ul class="article-list">
      {articles.map(a => (
        <li class="article-item">
          <a href={`/${a.data.slug}/`} class="row-img">
            <img src={a.data.image} alt={a.data.imageAlt ?? a.data.title} loading="lazy" />
          </a>
          <div class="row-body">
            <a href={`/${a.data.slug}/`}><h2>{a.data.title}</h2></a>
            {a.data.excerpt && <p class="excerpt">{a.data.excerpt}</p>}
            <div class="byline">
              <span class="avatar avatar-sm">{authorInitial(a.data.author)}</span>
              <span class="byline-name">{a.data.author ?? 'Editorial'}</span>
              <span class="byline-dot">·</span>
              <span class="byline-time">{fmtRelative(a.data.date)}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>

<style>
  .cat-header {
    padding: 36px 0 28px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 28px;
  }

  .cat-header h1 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.18;
    letter-spacing: -0.018em;
    margin: 12px 0 10px;
  }

  .cat-blurb {
    font-size: 0.98rem;
    color: var(--text-soft);
    margin: 0 0 8px;
    max-width: 580px;
  }

  .cat-count {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 22px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .article-item:last-child { border-bottom: none; }

  .row-img {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .row-img img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .row-body h2 {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.012em;
    margin: 0 0 8px;
  }

  .row-body h2:hover { color: var(--accent); }

  .excerpt {
    font-size: 0.95rem;
    color: var(--text-soft);
    margin-bottom: 12px;
    line-height: 1.55;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .avatar {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .byline-name { font-weight: 600; color: var(--text); }
  .byline-dot { color: var(--rule); }

  @media (max-width: 720px) {
    .article-item { grid-template-columns: 130px 1fr; gap: 14px; }
  }
</style>