---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { CATEGORIES, CATEGORY_COLORS } from '../../content.config';

export async function getStaticPaths() {
  return Object.entries(CATEGORIES).map(([slug, label]) => ({
    params: { slug },
    props: { slug, label },
  }));
}

interface Props {
  slug: string;
  label: string;
}

const { slug, label } = Astro.props;
const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => a.data.categorySlugs.includes(slug))
  .sort((a, b) => {
    const ap = a.data.pinned ? 1 : 0;
    const bp = b.data.pinned ? 1 : 0;
    if (ap !== bp) return bp - ap;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

function fmtDate(iso: string | Date) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const accent = CATEGORY_COLORS[slug as keyof typeof CATEGORY_COLORS];
---

<Layout title={label}>
  <Header />

  <main class="container">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span class="current">{label}</span>
    </nav>

    <header class="cat-hero" style={`--accent-color: ${accent}`}>
      <span class="cat-pill" style={`color:${accent}`}>Section</span>
      <h1>{label}</h1>
      <p class="cat-blurb">Editorial essays, slow reads, and considered notes — from the {label.toLowerCase()} desk.</p>
      <p class="cat-count">{articles.length} {articles.length === 1 ? 'story' : 'stories'}</p>
    </header>

    <ul class="article-list">
      {articles.map(a => (
        <li class="article-row">
          <a href={`/${a.data.slug}/`} class="row-img">
            <img src={a.data.image} alt={a.data.imageAlt ?? a.data.title} loading="lazy" />
          </a>
          <div class="row-body">
            <span class={`cat-pill cat-${slug}`}>{a.data.categories[0]}</span>
            <a href={`/${a.data.slug}/`}><h2>{a.data.title}</h2></a>
            <p class="excerpt">{a.data.excerpt}</p>
            <div class="byline">
              <span>{a.data.author ?? 'Editorial'}</span>
              <span class="byline-dot">·</span>
              <span>{fmtDate(a.data.date)}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--text-muted);
    padding: 30px 0 0;
  }

  .breadcrumb a:hover { color: var(--accent-deep); }

  .breadcrumb .current { color: var(--text); }

  .cat-hero {
    text-align: center;
    padding: 30px 0 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--rule);
  }

  .cat-hero h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
    margin: 14px 0 14px;
    color: var(--accent-color);
  }

  .cat-blurb {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--text-soft);
    max-width: 560px;
    margin: 0 auto 14px;
  }

  .cat-count {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 28px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }

  .article-row:first-child { padding-top: 0; }
  .article-row:last-child { border-bottom: none; }

  .row-img {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .row-img img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform .4s ease;
  }

  .row-img:hover img { transform: scale(1.04); }

  .row-body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.012em;
    margin: 8px 0 12px;
  }

  .row-body h2:hover { color: var(--accent-deep); }

  .excerpt {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-soft);
    margin-bottom: 14px;
  }

  .byline {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .byline-dot { color: var(--rule); }

  @media (max-width: 720px) {
    .article-row { grid-template-columns: 140px 1fr; gap: 18px; }
  }
</style>