---
import { CATEGORIES } from '../content.config';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="pill">
    <a href="/" class="brand">
      <span class="brand-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28">
          <defs>
            <linearGradient id="ra-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ff3b30"/>
              <stop offset="33%" stop-color="#ff9500"/>
              <stop offset="66%" stop-color="#34c759"/>
              <stop offset="100%" stop-color="#007aff"/>
            </linearGradient>
          </defs>
          <circle cx="16" cy="16" r="14" fill="url(#ra-grad)"/>
          <circle cx="16" cy="16" r="6" fill="white"/>
        </svg>
      </span>
      <span class="brand-name">RevueAura</span>
    </a>

    <nav class="cat-list" aria-label="Primary">
      <a href="/" class:list={[{ active: isActive('/') && currentPath === '/' }]}>Latest</a>
      {Object.entries(CATEGORIES).map(([s, label]) => (
        <a
          href={`/category/${s}/`}
          class:list={[{ active: isActive(`/category/${s}`) }]}
        >{label}</a>
      ))}
    </nav>

    <div class="util-right">
      <a href="#newswire" class="util-link newswire-link">
        <span class="dot"></span>Newswire
      </a>
      <a href="/contact/" class="util-link">Submit a tip</a>
      <button class="search-btn" aria-label="Search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
    </div>

    <button class="mobile-toggle" aria-label="Toggle navigation" id="mobileToggle">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 14px;
    z-index: 100;
    padding: 0 24px;
  }

  .pill {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 8px 18px 8px 14px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-radius: 999px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07), 0 1px 2px rgba(0,0,0,0.04);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .brand-icon { display: inline-flex; }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .cat-list {
    display: flex;
    align-items: center;
    gap: 0 16px;
    flex: 1;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cat-list a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    padding: 4px 0;
    white-space: nowrap;
  }

  .cat-list a:hover,
  .cat-list a.active {
    color: var(--accent);
  }

  .util-right {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .util-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .util-link:hover { color: var(--accent); }

  .newswire-link .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff3b30;
    box-shadow: 0 0 0 3px rgba(255, 59, 48, 0.18);
  }

  .search-btn {
    background: transparent;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: var(--text);
    display: inline-flex;
  }

  .search-btn:hover { color: var(--accent); }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    padding: 6px;
    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    margin: 3px 0;
  }

  @media (max-width: 1080px) {
    .cat-list { gap: 0 12px; }
    .cat-list a { font-size: 0.82rem; }
  }

  @media (max-width: 900px) {
    .cat-list { display: none; }
    .util-right .util-link:not(.newswire-link) { display: none; }
    .search-btn { display: none; }
  }

  @media (max-width: 640px) {
    .site-header { padding: 0 14px; top: 10px; }
    .pill { padding: 8px 12px; }
    .mobile-toggle { display: block; }
  }
</style>

<script>
  const toggle = document.getElementById('mobileToggle');
  const list = document.querySelector('.cat-list');
  if (toggle && list) {
    toggle.addEventListener('click', () => {
      if (list instanceof HTMLElement) list.style.display = list.style.display === 'flex' ? 'none' : 'flex';
    });
  }
</script>