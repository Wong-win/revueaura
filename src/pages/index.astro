---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_COLORS } from '../content.config';

const articles = (await getCollection('articles')).sort((a, b) => {
  // Pinned first, then date desc
  const ap = a.data.pinned ? 1 : 0;
  const bp = b.data.pinned ? 1 : 0;
  if (ap !== bp) return bp - ap;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Newswire — most recent 10
const newswire = articles.slice(0, 10);

function fmtDate(iso: string | Date) {
  const d = new Date(iso);
  const now = Date.now();
  const diff = now - d.getTime();
  const day = 86400000;
  if (diff < day) return d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  if (diff < 7 * day) return `${Math.floor(diff / day)}d ago`;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

const categoryEntries = Object.entries(CATEGORIES);
---

<Layout title="RevueAura">
  <Header />

  <main class="container">

    <!-- Hero -->
    <section class="hero">
      <h1 class="hero-title">
        A magazine for the way you<br/>
        <em>actually live.</em>
      </h1>
      <p class="hero-sub">
        Editorial essays on style, beauty, home, technology, and the outdoors — written slowly, read slowly.
      </p>
    </section>

    <!-- Newswire ticker -->
    <section class="newswire">
      <div class="newswire-head">
        <span class="nw-label">Newswire</span>
        <span class="nw-dot"></span>
        <span class="nw-sub">Latest dispatches</span>
      </div>
      <ul class="newswire-list">
        {newswire.map(a => (
          <li>
            <span class="nw-time">{fmtDate(a.data.date)}</span>
            <span class="nw-cat" style={`color:${CATEGORY_COLORS[a.data.categorySlugs[0] as keyof typeof CATEGORY_COLORS] ?? 'var(--accent)'}`}>
              {a.data.categories[0]}
            </span>
            <a href={`/${a.data.slug}/`} class="nw-headline">{a.data.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 5 category sections, single-column card list each -->
    {categoryEntries.map(([slug, label]) => {
      const catArticles = articles.filter(a => a.data.categorySlugs.includes(slug));
      const featured = catArticles[0];
      const rest = catArticles.slice(1, 5);
      return (
        <section class={`cat-section cat-${slug}`} id={`cat-${slug}`}>
          <div class="section-head">
            <h2><a href={`/category/${slug}/`}>{label}</a></h2>
            <a href={`/category/${slug}/`} class="see-all">All in {label.split(' ')[0]} →</a>
          </div>

          {featured && (
            <article class="featured-card">
              <a href={`/${featured.data.slug}/`} class="featured-img-wrap">
                <img src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} loading="lazy" />
                <span class={`cat-pill cat-${slug}`}>{featured.data.categories[0]}</span>
              </a>
              <div class="featured-body">
                <a href={`/${featured.data.slug}/`}><h3>{featured.data.title}</h3></a>
                <p class="excerpt">{featured.data.excerpt}</p>
                <div class="byline">
                  <span>{featured.data.author ?? 'Editorial'}</span>
                  <span class="byline-dot">·</span>
                  <span>{fmtDate(featured.data.date)}</span>
                </div>
              </div>
            </article>
          )}

          {rest.length > 0 && (
            <ul class="card-list">
              {rest.map(a => (
                <li class="card">
                  <a href={`/${a.data.slug}/`} class="card-img-wrap">
                    <img src={a.data.image} alt={a.data.imageAlt ?? a.data.title} loading="lazy" />
                  </a>
                  <div class="card-body">
                    <span class={`cat-pill cat-${slug}`}>{a.data.categories[0]}</span>
                    <a href={`/${a.data.slug}/`}><h4>{a.data.title}</h4></a>
                    <div class="byline">
                      <span>{a.data.author ?? 'Editorial'}</span>
                      <span class="byline-dot">·</span>
                      <span>{fmtDate(a.data.date)}</span>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })}

  </main>

  <Footer />
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 40px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 5.2vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.022em;
    margin: 0 0 18px;
    color: var(--text);
  }

  .hero-title em {
    font-style: italic;
    color: var(--accent-deep);
    font-weight: 500;
  }

  .hero-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--text-soft);
    max-width: 620px;
    margin: 0 auto;
  }

  /* Newswire — appleosophy-inspired */
  .newswire {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 18px 22px;
    margin-bottom: 60px;
  }

  .newswire-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--rule);
  }

  .nw-label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep);
    background: var(--accent-soft);
    padding: 3px 9px;
    border-radius: 4px;
  }

  .nw-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d44a3f;
    box-shadow: 0 0 0 4px rgba(212,74,63,.12);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  .nw-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .newswire-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
  }

  .newswire-list li {
    display: grid;
    grid-template-columns: 84px 140px 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--rule);
  }

  .newswire-list li:last-child { border-bottom: none; }

  .nw-time {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .nw-cat {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nw-headline {
    color: var(--text);
    font-weight: 500;
    line-height: 1.35;
  }

  .nw-headline:hover { color: var(--accent-deep); }

  @media (max-width: 640px) {
    .newswire-list li {
      grid-template-columns: 64px 1fr;
    }
    .nw-cat { grid-column: 1 / 2; }
    .nw-headline { grid-column: 1 / 3; padding-left: 80px; }
  }

  /* Category sections */
  .cat-section {
    margin-bottom: 80px;
  }

  .cat-section .section-head h2 a:hover { color: var(--accent-deep); }

  .featured-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 32px;
    margin-bottom: 28px;
  }

  .featured-img-wrap {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .featured-img-wrap img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .featured-img-wrap:hover img { transform: scale(1.03); }

  .featured-img-wrap .cat-pill {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(255,255,255,0.92);
  }

  .featured-body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 600;
    line-height: 1.18;
    margin: 8px 0 14px;
    letter-spacing: -0.014em;
  }

  .featured-body h3:hover { color: var(--accent-deep); }

  .excerpt {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-soft);
    margin-bottom: 16px;
  }

  .byline {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .byline-dot { color: var(--rule); }

  /* Card list (single column w/ horizontal layout) */
  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  .card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 22px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }

  .card:last-child { border-bottom: none; }

  .card-img-wrap {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card-img-wrap img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform .4s ease;
  }

  .card-img-wrap:hover img { transform: scale(1.04); }

  .card-body h4 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 8px 0 10px;
    letter-spacing: -0.01em;
  }

  .card-body h4:hover { color: var(--accent-deep); }

  @media (max-width: 720px) {
    .featured-card { grid-template-columns: 1fr; }
    .card { grid-template-columns: 120px 1fr; gap: 14px; }
  }
</style>