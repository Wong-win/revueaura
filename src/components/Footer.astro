---
import { CATEGORIES } from '../content.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand">RevueAura</a>
        <p class="brand-tag">An editorial lifestyle magazine — slow reads on style, beauty, home, technology, and the outdoors.</p>
        <div class="socials">
          <a href="#" aria-label="Instagram" class="social">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
            </svg>
          </a>
          <a href="#" aria-label="X" class="social">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" aria-label="Facebook" class="social">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07c0 4.99 3.66 9.13 8.44 9.93v-7.02H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.33V22c4.78-.8 8.43-4.94 8.43-9.93z"/></svg>
          </a>
          <a href="#" aria-label="YouTube" class="social">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.5c-.3-2-1-3-2.4-3.2C18 4 12 4 12 4s-6 0-8.6.3C2 4.5 1.3 5.5 1 7.5.7 9.7.7 12 .7 12s0 2.3.3 4.5c.3 2 1 3 2.4 3.2C6 20 12 20 12 20s6 0 8.6-.3c1.4-.2 2.1-1.2 2.4-3.2.3-2.2.3-4.5.3-4.5s0-2.3-.3-4.5zM9.7 15.5V8.5l6 3.5-6 3.5z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Coverage</h4>
        <ul>
          {Object.entries(CATEGORIES).map(([s, label]) => (
            <li><a href={`/category/${s}/`}>{label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>RevueAura</h4>
        <ul>
          <li><a href="/">Latest</a></li>
          <li><a href="#newswire">Newswire</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Submit a tip</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy</a></li>
          <li><a href="/privacy-policy/#terms">Terms</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} RevueAura — Editorial lifestyle, written slowly.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 60px;
    background: var(--surface-2);
    border-top: 1px solid var(--rule);
    padding: 48px 0 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 32px;
  }

  .footer-brand {
    display: inline-block;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
    letter-spacing: -0.015em;
  }

  .brand-tag {
    font-size: 0.85rem;
    color: var(--text-soft);
    margin: 0 0 14px;
    max-width: 320px;
    line-height: 1.5;
  }

  .socials {
    display: flex;
    gap: 12px;
  }

  .social {
    color: var(--text-muted);
    transition: color .14s ease;
  }

  .social:hover { color: var(--text); }

  .footer-col h4 {
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    margin: 0 0 12px;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-col li {
    padding: 3px 0;
  }

  .footer-col a {
    font-size: 0.86rem;
    color: var(--text-soft);
  }

  .footer-col a:hover { color: var(--accent); }

  .footer-bottom {
    border-top: 1px solid var(--rule);
    padding-top: 18px;
  }

  .footer-bottom p {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>