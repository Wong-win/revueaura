---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../content.config';

const articles = (await getCollection('articles')).sort((a, b) => {
  const ap = a.data.pinned ? 1 : 0;
  const bp = b.data.pinned ? 1 : 0;
  if (ap !== bp) return bp - ap;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const featured = articles.find(a => a.data.pinned) ?? articles[0];
const newswire = articles.slice(0, 6);
const latest = articles.filter(a => a.data.slug !== featured.data.slug).slice(0, 12);
---

<Layout title="RevueAura">
  <Header />

  <main class="container">

    <!-- FEATURED — full-width with overlay -->
    <section class="featured" aria-label="Featured story">
      <a href={`/${featured.data.slug}/`} class="featured-img">
        <img src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} loading="eager" />
        <div class="overlay"></div>
      </a>
      <div class="featured-body">
        <a href={`/category/${featured.data.categorySlugs[0]}/`}>
          <span class={`tag tag-${featured.data.categorySlugs[0]}`}>{featured.data.categories[0]}</span>
        </a>
        <a href={`/${featured.data.slug}/`}><h1>{featured.data.title}</h1></a>
      </div>
    </section>

    <!-- TWO-COLUMN ROW: latest feed | newswire sidebar -->
    <div class="row-2col">

      <div class="feed-col">
        <div class="section-head">
          <h2>Latest stories</h2>
          <a href="#newswire" class="see-all">See everything →</a>
        </div>

        <div class="grid-2">
          {latest.map(a => (
            <article class="card">
              <a href={`/${a.data.slug}/`} class="card-img">
                <img src={a.data.image} alt={a.data.imageAlt ?? a.data.title} loading="lazy" />
              </a>
              <a href={`/category/${a.data.categorySlugs[0]}/`}>
                <span class={`tag tag-${a.data.categorySlugs[0]}`}>{a.data.categories[0]}</span>
              </a>
              <a href={`/${a.data.slug}/`}><h3>{a.data.title}</h3></a>
            </article>
          ))}
        </div>
      </div>

      <aside class="sidebar-col">
        <div class="section-head" id="newswire">
          <h2>Newswire</h2>
          <a href="/" class="see-all">View all →</a>
        </div>

        <ul class="newswire-list">
          {newswire.map(a => (
            <li class="nw-item">
              <a href={`/${a.data.slug}/`} class="nw-img">
                <img src={a.data.image} alt={a.data.imageAlt ?? a.data.title} loading="lazy" />
              </a>
              <div class="nw-body">
                <a href={`/${a.data.slug}/`} class="nw-headline">{a.data.title}</a>
                <a href={`/category/${a.data.categorySlugs[0]}/`} class={`nw-cat tag tag-${a.data.categorySlugs[0]}`}>{a.data.categories[0]}</a>
              </div>
            </li>
          ))}
        </ul>

        <!-- Pulse widget (appleosophy AAPL analogue) -->
        <div class="pulse">
          <div class="pulse-head">
            <h3>The Pulse</h3>
            <span class="pulse-sub">This week's reads.</span>
          </div>
          <ul class="pulse-list">
            {Object.entries(CATEGORIES).map(([s, label]) => {
              const recent = articles.find(a => a.data.categorySlugs.includes(s));
              if (!recent) return null;
              return (
                <li class="pulse-item">
                  <a href={`/${recent.data.slug}/`} class="pulse-img">
                    <img src={recent.data.image} alt={recent.data.imageAlt ?? recent.data.title} loading="lazy" />
                  </a>
                  <div class="pulse-body">
                    <span class={`pulse-tag tag tag-${s}`}>{label}</span>
                    <a href={`/${recent.data.slug}/`} class="pulse-title">{recent.data.title}</a>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </aside>
    </div>

  </main>

  <Footer />
</Layout>

<style>
  /* Featured — full-width image with text overlay */
  .featured {
    position: relative;
    margin: 28px 0 36px;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 7;
    max-height: 540px;
  }

  .featured-img { display: block; width: 100%; height: 100%; }
  .featured-img img { width: 100%; height: 100%; object-fit: cover; }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 30%, rgba(0,0,0,0.85) 100%);
  }

  .featured-body {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 28px 32px;
    color: white;
  }

  .featured-body h1 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.7rem, 4vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 12px 0 0;
    color: white;
    max-width: 800px;
  }

  /* Two-column row */
  .row-2col {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    margin-bottom: 60px;
  }

  /* Section header */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 22px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }

  .section-head h2 {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.018em;
    margin: 0;
  }

  .see-all { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; }
  .see-all:hover { color: var(--accent); }

  /* Cards grid — 2 columns */
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 24px;
  }

  .card { display: flex; flex-direction: column; }

  .card-img {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
  }

  .card-img img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card .tag { margin-bottom: 10px; }

  .card h3 {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.012em;
    margin: 0;
  }

  .card h3:hover { color: var(--accent); }

  /* Sidebar */
  .sidebar-col { min-width: 0; }

  .newswire-list { list-style: none; margin: 0 0 32px; padding: 0; }

  .nw-item {
    display: grid;
    grid-template-columns: 72px 1fr;
    column-gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule-soft);
    align-items: center;
  }

  .nw-item:last-child { border-bottom: none; }

  .nw-img {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 6px;
    overflow: hidden;
  }

  .nw-img img { width: 100%; height: 100%; object-fit: cover; }

  .nw-body { min-width: 0; }

  .nw-headline {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.32;
    color: var(--text);
    margin-bottom: 5px;
  }

  .nw-headline:hover { color: var(--accent); }

  .nw-cat {
    font-size: 0.65rem;
    padding: 2px 6px;
  }

  /* Pulse widget */
  .pulse {
    padding: 20px;
    background: var(--surface-2);
    border-radius: 8px;
  }

  .pulse-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }

  .pulse-head h3 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }

  .pulse-sub { font-size: 0.7rem; color: var(--text-muted); }

  .pulse-list { list-style: none; margin: 0; padding: 0; }

  .pulse-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    column-gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    align-items: center;
  }

  .pulse-item:last-child { border-bottom: none; padding-bottom: 0; }
  .pulse-item:first-child { padding-top: 0; }

  .pulse-img {
    display: block;
    width: 64px;
    height: 64px;
    border-radius: 6px;
    overflow: hidden;
  }

  .pulse-img img { width: 100%; height: 100%; object-fit: cover; }

  .pulse-body { min-width: 0; }

  .pulse-tag {
    font-size: 0.62rem;
    padding: 2px 6px;
    margin-bottom: 4px;
  }

  .pulse-title {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.32;
    color: var(--text);
  }

  .pulse-title:hover { color: var(--accent); }

  @media (max-width: 920px) {
    .row-2col { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .featured { aspect-ratio: 16 / 9; max-height: 400px; }
    .featured-body { padding: 18px 18px; }
    .grid-2 { grid-template-columns: 1fr; gap: 22px; }
  }
</style>