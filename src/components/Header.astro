---
import { CATEGORIES } from '../content.config';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <!-- Row 1: Logo · tagline · social -->
  <div class="header-top">
    <div class="container header-inner">
      <a href="/" class="brand">RevueAura</a>
      <span class="tagline">An editorial lifestyle magazine</span>
      <div class="socials">
        <a href="#" aria-label="Instagram" class="social">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
          </svg>
        </a>
        <a href="#" aria-label="X" class="social">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="#" aria-label="Facebook" class="social">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07c0 4.99 3.66 9.13 8.44 9.93v-7.02H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.33V22c4.78-.8 8.43-4.94 8.43-9.93z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Row 2: Primary nav + secondary row -->
  <div class="header-main">
    <div class="container">
      <div class="nav-row">
        <ul class="cat-list">
          <li><a href="/" class={isActive('/') && currentPath === '/' ? 'active' : ''}>Latest</a></li>
          {Object.entries(CATEGORIES).map(([s, label]) => (
            <li>
              <a
                href={`/category/${s}/`}
                class:list={[{ active: isActive(`/category/${s}`) }]}
              >{label}</a>
            </li>
          ))}
        </ul>
        <button class="mobile-toggle" aria-label="Toggle navigation" id="mobileToggle">
          <span></span><span></span><span></span>
        </button>
      </div>

      <div class="util-row" id="utilRow">
        <div class="util-left">
          <a href="#newswire" class="util-link">Newswire</a>
          <a href="/contact/" class="util-link">Submit a tip</a>
        </div>
        <div class="util-right">
          <button class="util-link search-btn" aria-label="Search">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }

  /* Row 1 — logo + tagline + socials */
  .header-top {
    padding: 14px 0 10px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .brand {
    font-family: var(--font-body);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.018em;
    color: var(--text);
  }

  .tagline {
    flex: 1;
    text-align: center;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .socials {
    display: flex;
    gap: 12px;
  }

  .social {
    color: var(--text-muted);
    transition: color .14s ease;
  }

  .social:hover { color: var(--text); }

  /* Row 2 — nav */
  .header-main { padding: 0; }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0 10px;
  }

  .cat-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cat-list a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    padding: 4px 0;
  }

  .cat-list a:hover,
  .cat-list a.active {
    color: var(--accent);
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    padding: 6px;
    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text);
    margin: 3px 0;
  }

  /* Row 3 — utilities */
  .util-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0 12px;
    border-top: 1px solid var(--rule-soft);
    margin-top: 4px;
  }

  .util-left, .util-right {
    display: flex;
    gap: 18px;
  }

  .util-link {
    font-size: 0.82rem;
    color: var(--text-soft);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .util-link:hover { color: var(--accent); }

  @media (max-width: 860px) {
    .tagline { display: none; }
    .header-inner { justify-content: space-between; }
    .cat-list { gap: 0 14px; }
    .cat-list a { font-size: 0.85rem; }
    .util-left { gap: 12px; }
  }

  @media (max-width: 640px) {
    .mobile-toggle { display: block; }
    .cat-list { display: none; flex-direction: column; }
    .cat-list.open { display: flex; padding: 8px 0; gap: 6px; }
    .util-row { padding: 10px 0; }
  }
</style>

<script>
  const toggle = document.getElementById('mobileToggle');
  const list = document.querySelector('.cat-list');
  if (toggle && list) {
    toggle.addEventListener('click', () => list.classList.toggle('open'));
  }
</script>