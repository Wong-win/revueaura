---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Not Found">
  <Header />
  <main class="container">
    <div class="nf-wrap">
      <p class="nf-code">404</p>
      <h1>This page drifted out of frame.</h1>
      <p class="nf-sub">The story you're looking for isn't here. Perhaps it found another home, or perhaps it was never written. Either way, the front page is waiting.</p>
      <a href="/" class="btn">← Return to Latest</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .nf-wrap {
    text-align: center;
    padding: 100px 20px 60px;
    max-width: 540px;
    margin: 0 auto;
  }

  .nf-code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 5rem;
    color: var(--accent);
    line-height: 1;
    margin: 0 0 8px;
    letter-spacing: -0.04em;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0 0 16px;
  }

  .nf-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--text-soft);
    margin-bottom: 28px;
  }
</style>