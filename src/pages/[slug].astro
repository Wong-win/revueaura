---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, image, imageAlt, excerpt, categories, categorySlugs, author, date } = article.data;
const htmlContent = marked.parse(article.body ?? '') as string;

function fmtFull(d: string | Date) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
function authorInitial(name?: string) {
  return (name ?? 'E').charAt(0).toUpperCase();
}
---

<Layout title={title} description={excerpt} image={image} type="article">
  <Header />

  <main class="container">
    <article class="article-single">

      <header class="article-head">
        <a href={`/category/${categorySlugs[0]}/`}>
          <span class={`tag tag-${categorySlugs[0]}`}>{categories[0]}</span>
        </a>
        <h1>{title}</h1>
        {excerpt && <p class="lede">{excerpt}</p>}
        <div class="byline">
          <span class="avatar">{authorInitial(author)}</span>
          <span class="byline-name">{author ?? 'Editorial'}</span>
          <span class="byline-dot">·</span>
          <span class="byline-time">{fmtFull(date)}</span>
        </div>
      </header>

      {image && (
        <figure class="article-hero">
          <img src={image} alt={imageAlt ?? title} />
        </figure>
      )}

      <div class="article-body prose" set:html={htmlContent}></div>

    </article>
  </main>

  <Footer />
</Layout>

<style>
  .article-single {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 28px 0 40px;
  }

  .article-head { margin-bottom: 24px; }

  .article-head h1 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.14;
    letter-spacing: -0.022em;
    margin: 14px 0 14px;
  }

  .lede {
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--text-soft);
    margin-bottom: 18px;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .avatar {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff3b30, #ff9500, #34c759, #007aff);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .byline-name { font-weight: 600; color: var(--text); }
  .byline-dot { color: var(--rule); }

  .article-hero {
    margin: 0 0 32px;
    border-radius: 12px;
    overflow: hidden;
  }

  .article-hero img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-body :global(h2) {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.5rem;
    margin-top: 1.8em;
    letter-spacing: -0.012em;
  }

  .article-body :global(h3) {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.2rem;
    margin-top: 1.4em;
  }

  .article-body :global(p) {
    font-size: 1.075rem;
    line-height: 1.72;
  }

  .article-body :global(blockquote) {
    margin: 1.6em 0;
    padding: 0 0 0 1em;
    border-left: 3px solid var(--accent);
    font-size: 1.08rem;
    color: var(--text-soft);
  }

  .article-body :global(img) {
    margin: 1.8em 0;
    border-radius: 8px;
  }

  .article-body :global(ul), .article-body :global(ol) {
    padding-left: 1.4em;
    line-height: 1.72;
  }

  .article-body :global(li) { margin: 0.3em 0; }
</style>