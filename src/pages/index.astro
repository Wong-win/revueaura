---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../content.config';

const articles = (await getCollection('articles')).sort((a, b) => {
  const ap = a.data.pinned ? 1 : 0;
  const bp = b.data.pinned ? 1 : 0;
  if (ap !== bp) return bp - ap;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Pinned = featured (or first article if none pinned)
const featured = articles.find(a => a.data.pinned) ?? articles[0];

// Newswire: top 8 (may include featured)
const newswire = articles.slice(0, 8);

// Latest feed: everything except featured, capped at 16
const latest = articles.filter(a => a.data.slug !== featured.data.slug).slice(0, 16);

function fmtRelative(iso: string | Date) {
  const d = new Date(iso);
  const now = Date.now();
  const diff = now - d.getTime();
  const min = 60000, hr = 3600000, day = 86400000;
  if (diff < min) return 'just now';
  if (diff < hr) return `${Math.floor(diff / min)}m ago`;
  if (diff < day) return `${Math.floor(diff / hr)}h ago`;
  if (diff < 7 * day) return `${Math.floor(diff / day)}d ago`;
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

function authorInitial(name?: string) {
  return (name ?? 'E').charAt(0).toUpperCase();
}
---

<Layout title="RevueAura">
  <Header />

  <main class="container">

    <!-- FEATURED — full-bleed large card -->
    <section class="featured" aria-label="Featured story">
      <a href={`/${featured.data.slug}/`} class="featured-img">
        <img src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} loading="eager" />
      </a>
      <div class="featured-body">
        <a href={`/category/${featured.data.categorySlugs[0]}/`}>
          <span class={`tag tag-${featured.data.categorySlugs[0]}`}>{featured.data.categories[0]}</span>
        </a>
        <a href={`/${featured.data.slug}/`}><h1>{featured.data.title}</h1></a>
        {featured.data.excerpt && <p class="lede">{featured.data.excerpt}</p>}
        <div class="byline">
          <span class="avatar">{authorInitial(featured.data.author)}</span>
          <span class="byline-name">{featured.data.author ?? 'Editorial'}</span>
          <span class="byline-dot">·</span>
          <span class="byline-time">{fmtRelative(featured.data.date)}</span>
        </div>
      </div>
    </section>

    <!-- TWO-COLUMN ROW: main feed | newswire sidebar -->
    <div class="row-2col">

      <!-- Main feed -->
      <div class="feed-col">
        <div class="section-head">
          <span class="dash"></span>
          <h2>Latest Stories</h2>
        </div>

        <ul class="feed-list">
          {latest.map(a => (
            <li class="feed-item">
              <a href={`/${a.data.slug}/`} class="feed-img">
                <img src={a.data.image} alt={a.data.imageAlt ?? a.data.title} loading="lazy" />
              </a>
              <div class="feed-body">
                <a href={`/category/${a.data.categorySlugs[0]}/`}>
                  <span class={`tag tag-${a.data.categorySlugs[0]}`}>{a.data.categories[0]}</span>
                </a>
                <a href={`/${a.data.slug}/`}><h3>{a.data.title}</h3></a>
                <div class="byline byline-sm">
                  <span class="avatar avatar-sm">{authorInitial(a.data.author)}</span>
                  <span class="byline-name">{a.data.author ?? 'Editorial'}</span>
                  <span class="byline-dot">·</span>
                  <span class="byline-time">{fmtRelative(a.data.date)}</span>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Sidebar -->
      <aside class="sidebar-col">
        <div class="section-head" id="newswire">
          <span class="dash"></span>
          <h2>Newswire</h2>
        </div>

        <ul class="newswire-list">
          {newswire.map(a => (
            <li class="nw-item">
              <span class="nw-time">{fmtRelative(a.data.date)}</span>
              <a href={`/${a.data.slug}/`} class="nw-headline">{a.data.title}</a>
              <span class={`tag tag-${a.data.categorySlugs[0]} tag-sm`}>{a.data.categories[0]}</span>
            </li>
          ))}
        </ul>

        <!-- Pulse widget (appleosophy AAPL analogue) -->
        <div class="pulse">
          <div class="section-head" style="margin-bottom:10px">
            <span class="dash"></span>
            <h2>The Pulse</h2>
          </div>
          <p class="pulse-blurb">What we're thinking about this week.</p>
          <ul class="pulse-list">
            {Object.entries(CATEGORIES).slice(0, 3).map(([s, label]) => {
              const recent = articles.find(a => a.data.categorySlugs.includes(s));
              if (!recent) return null;
              return (
                <li>
                  <span class="pulse-cat">{label}</span>
                  <a href={`/${recent.data.slug}/`} class="pulse-title">{recent.data.title}</a>
                </li>
              );
            })}
          </ul>
        </div>
      </aside>
    </div>

  </main>

  <Footer />
</Layout>

<style>
  /* Featured — top story, large image + body */
  .featured {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 36px;
    padding: 28px 0 36px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 40px;
  }

  .featured-img {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .featured-img img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .featured-body { padding: 8px 0; }

  .featured-body h1 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.18;
    letter-spacing: -0.018em;
    margin: 14px 0 14px;
  }

  .featured-body h1:hover { color: var(--accent); }

  .lede {
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--text-soft);
    margin-bottom: 18px;
  }

  /* Byline */
  .byline {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .byline-sm { font-size: 0.78rem; }

  .avatar {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .avatar-sm { width: 22px; height: 22px; font-size: 0.68rem; }

  .byline-name {
    font-weight: 600;
    color: var(--text);
  }

  .byline-dot { color: var(--rule); }

  /* Two-column row */
  .row-2col {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    margin-bottom: 60px;
  }

  /* Feed column */
  .feed-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }

  .feed-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 18px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .feed-item:last-child { border-bottom: none; padding-bottom: 0; }

  .feed-img {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .feed-img img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .feed-body { padding: 2px 0; }

  .feed-body h3 {
    font-family: var(--font-body);
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.012em;
    margin: 10px 0 10px;
  }

  .feed-body h3:hover { color: var(--accent); }

  /* Sidebar */
  .sidebar-col { min-width: 0; }

  .newswire-list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
  }

  .nw-item {
    display: grid;
    grid-template-columns: 78px 1fr;
    grid-template-rows: auto auto;
    column-gap: 12px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--rule-soft);
  }

  .nw-item:last-child { border-bottom: none; }

  .nw-time {
    grid-row: 1 / 3;
    font-size: 0.74rem;
    color: var(--text-muted);
    align-self: start;
    padding-top: 1px;
  }

  .nw-headline {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .nw-headline:hover { color: var(--accent); }

  .tag-sm {
    font-size: 0.62rem;
    padding: 1px 5px;
    margin-top: 4px;
    justify-self: start;
  }

  /* Pulse widget */
  .pulse {
    padding: 18px 16px;
    background: var(--surface-2);
    border-radius: var(--radius);
  }

  .pulse-blurb {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0 0 12px;
  }

  .pulse-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pulse-list li {
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
  }

  .pulse-list li:last-child { border-bottom: none; padding-bottom: 0; }

  .pulse-cat {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .pulse-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .pulse-title:hover { color: var(--accent); }

  @media (max-width: 920px) {
    .featured { grid-template-columns: 1fr; }
    .row-2col { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .feed-item { grid-template-columns: 120px 1fr; gap: 14px; }
    .feed-body h3 { font-size: 1.04rem; }
  }
</style>